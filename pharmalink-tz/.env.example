# ── Supabase (optional) ───────────────────────────────────────────
# When set, orders are persisted and stock data is read from the DB.
# Leave blank to run the app in zero-config demo mode (mock data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AISStream (optional) ──────────────────────────────────────────
# Free API key from https://aisstream.io. When set, the ship map shows
# real vessel positions across East African ports instead of a simulation.
NEXT_PUBLIC_AISSTREAM_KEY=
